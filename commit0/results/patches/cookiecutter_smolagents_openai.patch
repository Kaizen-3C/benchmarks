+def find_template(repo_dir: 'os.PathLike[str]', env: Environment) -> Path:
+    """Determine which child directory of ``repo_dir`` is the project template."""
+    repo_dir = Path(repo_dir)
+    candidates = [p for p in repo_dir.iterdir() if p.is_dir() and '{{' in p.name and '}}' in p.name]
+    if not candidates:
+        raise NonTemplatedInputDirException("No templated directory found")
+    return candidates[0]
