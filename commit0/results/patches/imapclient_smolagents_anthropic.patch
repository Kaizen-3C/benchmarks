+def assert_imap_protocol(condition, msg=None):
+    """Assert that a condition is true, raising a ProtocolError if not."""
+    if not condition:
+        msg = msg if msg is not None else "IMAP protocol error"
+        raise exceptions.ProtocolError(str(msg))
