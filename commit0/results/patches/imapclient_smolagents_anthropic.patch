+def _imapclient_version_string(version_info):
+    """Generate a version string from a version_info tuple.
+    
+    The 4th part will be either alpha, beta or final.
+    If final, no suffix is added.
+    Otherwise, a dash and the part is added.
+    """
+    major, minor, patch, release = version_info
+    version = "%d.%d.%d" % (major, minor, patch)
+    if release != "final":
+        version = "%s-%s" % (version, release)
+    return version
