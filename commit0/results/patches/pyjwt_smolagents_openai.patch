+    b"OPENSSH PRIVATE KEY",
+    b"DSA PRIVATE KEY",
+    b"RSA PRIVATE KEY",
+    b"RSA PUBLIC KEY",
+    b"EC PRIVATE KEY",
+    b"DH PARAMETERS",
+    b"NEW CERTIFICATE REQUEST",
+    b"CERTIFICATE REQUEST",
+    b"SSH2 PUBLIC KEY",
+    b"SSH2 ENCRYPTED PRIVATE KEY",
+    b"X509 CRL",
+}
+
+_PEM_RE = re.compile(
+    b"----[- ]BEGIN ("
+    + b"|".join(_PEMS)
+    + b")[- ]----\r?\n.+?\r?\n----[- ]END \\1[- ]----\r?\n?",
+    re.DOTALL,
+)
+
+_CERT_SUFFIX = b"-cert-v01@openssh.com"
+_SSH_PUBKEY_RC = re.compile(b"\\A(\\S+)[ \\t]+(\\S+)")
+_SSH_KEY_FORMATS = [
+    b"ssh-ed25519",
+    b"ssh-rsa",
+    b"ssh-dss",
+    b"ecdsa-sha2-nistp256",
+    b"ecdsa-sha2-nistp384",
+    b"ecdsa-sha2-nistp521",
+]
+
+
+def force_bytes(value: Union[bytes, str]) -> bytes:
+    if isinstance(value, str):
+        return value.encode("utf-8")
+    elif isinstance(value, bytes):
+        return value
+    else:
+        raise TypeError("Expected a string value")
+
+
+def base64url_decode(input: Union[bytes, str]) -> bytes:
+    if isinstance(input, str):
+        input = input.encode("ascii")
+    rem = len(input) % 4
+    if rem > 0:
+        input += b"=" * (4 - rem)
+    return base64.urlsafe_b64decode(input)
+
+
+def base64url_encode(input: bytes) -> bytes:
+    return base64.urlsafe_b64encode(input).rstrip(b"=")
+
+
+def to_base64url_uint(val: int) -> bytes:
+    if val < 0:
+        raise ValueError("Must be a positive integer")
+    int_bytes = bytes_from_int(val)
+    if len(int_bytes) == 0:
+        int_bytes = b"\x00"
+    return base64url_encode(int_bytes)
+
+
+def from_base64url_uint(val: Union[bytes, str]) -> int:
+    if isinstance(val, str):
+        val = val.encode("ascii")
+    data = base64url_decode(val)
+    return int.from_bytes(data, byteorder="big")
+
+
+def number_to_bytes(n: int, length: int) -> bytes:
+    return n.to_bytes(length, byteorder="big")
+
+
+def bytes_from_int(n: int) -> bytes:
+    length = (n.bit_length() + 7) // 8
+    return n.to_bytes(length, byteorder="big")
+
+
+def der_to_raw_signature(der_sig: bytes, curve: "EllipticCurve") -> bytes:
+    key_size = (curve.key_size + 7) // 8
+    r, s = decode_dss_signature(der_sig)
+    return number_to_bytes(r, key_size) + number_to_bytes(s, key_size)
+
+
+def raw_to_der_signature(raw_sig: bytes, curve: "EllipticCurve") -> bytes:
+    key_size = (curve.key_size + 7) // 8
+    if len(raw_sig) != 2 * key_size:
+        raise ValueError("Invalid signature")
+    r = int.from_bytes(raw_sig[:key_size], byteorder="big")
+    s = int.from_bytes(raw_sig[key_size:], byteorder="big")
+    return encode_dss_signature(r, s)
+
+
+def is_pem_format(key: bytes) -> bool:
+    return bool(_PEM_RE.search(key))
+
+
+def is_ssh_key(key: bytes) -> bool:
+    if any(key.startswith(fmt) for fmt in _SSH_KEY_FORMATS):
+        return True
+    # Check for cert format
+    for fmt in _SSH_KEY_FORMATS:
+        if key.startswith(fmt + _CERT_SUFFIX):
+            return True
+    return False