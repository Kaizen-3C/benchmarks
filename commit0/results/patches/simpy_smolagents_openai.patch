@@ -0,0 +1,52 @@
+from __future__ import annotations
+
+from simpy.resources.base import BaseResource, Get, Put
+
+class ContainerPut(Put):
+    def __init__(self, container, amount):
+        if amount <= 0:
+            raise ValueError('amount must be > 0.')
+        self.amount = amount
+        super().__init__(container)
+
+class ContainerGet(Get):
+    def __init__(self, container, amount):
+        if amount <= 0:
+            raise ValueError('amount must be > 0.')
+        self.amount = amount
+        super().__init__(container)
+
+class Container(BaseResource[ContainerPut, ContainerGet]):
+    def __init__(self, env, capacity=float('inf'), init=0):
+        if capacity <= 0:
+            raise ValueError('"capacity" must be > 0.')
+        if init < 0:
+            raise ValueError('"init" must be >= 0.')
+        if init > capacity:
+            raise ValueError('"init" must be <= "capacity".')
+        super().__init__(env, capacity)
+        self._level = init
+
+    @property
+    def level(self):
+        return self._level
+
+    def put(self, amount):
+        return ContainerPut(self, amount)
+
+    def get(self, amount):
+        return ContainerGet(self, amount)
+
+    def _do_put(self, event):
+        if self._capacity - self._level >= event.amount:
+            self._level += event.amount
+            event.succeed()
+            return True
+        return False
+
+    def _do_get(self, event):
+        if self._level >= event.amount:
+            self._level -= event.amount
+            event.succeed()
+            return True
+        return False
