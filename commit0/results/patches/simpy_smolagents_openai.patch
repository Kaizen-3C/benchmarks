@@ -0,0 +1,73 @@
+from __future__ import annotations
+
+from bisect import insort_right
+
+from simpy.resources.base import BaseResource, Get, Put
+
+class StorePut(Put):
+    def __init__(self, store, item):
+        self.item = item
+        super().__init__(store)
+
+class StoreGet(Get):
+    pass
+
+class FilterStoreGet(StoreGet):
+    def __init__(self, store, filter=lambda item: True):
+        self.filter = filter
+        super().__init__(store)
+
+class Store(BaseResource[StorePut, StoreGet]):
+    def __init__(self, env, capacity=float('inf')):
+        if capacity <= 0:
+            raise ValueError('"capacity" must be > 0')
+        super().__init__(env, capacity)
+        self.items = []
+
+    def put(self, item):
+        return StorePut(self, item)
+
+    def get(self):
+        return StoreGet(self)
+
+    def _do_put(self, event):
+        if len(self.items) < self.capacity:
+            self.items.append(event.item)
+            event.succeed()
+            return True
+        return False
+
+    def _do_get(self, event):
+        if self.items:
+            event.succeed(self.items.pop(0))
+            return True
+        return False
+
+class PriorityItem:
+    def __init__(self, priority, item):
+        self.priority = priority
+        self.item = item
+    def __lt__(self, other):
+        return self.priority < other.priority
+    def __iter__(self):
+        yield self.priority
+        yield self.item
+
+class PriorityStore(Store):
+    def _do_put(self, event):
+        if len(self.items) < self.capacity:
+            insort_right(self.items, event.item)
+            event.succeed()
+            return True
+        return False
+
+class FilterStore(Store):
+    def get(self, filter=lambda item: True):
+        return FilterStoreGet(self, filter)
+
+    def _do_get(self, event):
+        for i, item in enumerate(self.items):
+            if event.filter(item):
+                event.succeed(self.items.pop(i))
+                return True
+        return False
