@@ -0,0 +1,28 @@
+from __future__ import annotations
+
+from simpy.events import Event
+
+def start_delayed(env, generator, delay):
+    if delay <= 0:
+        raise ValueError('delay must be > 0')
+
+    def starter():
+        yield env.timeout(delay)
+        proc = env.process(generator)
+        return proc
+
+    return env.process(starter())
+
+def subscribe_at(event):
+    env = event.env
+    receiver = env.active_process
+    if receiver is None:
+        raise RuntimeError('subscribe_at() must be called from within a process')
+    if event.callbacks is None:
+        raise RuntimeError('Cannot subscribe to a terminated event')
+
+    def signaller(evt):
+        receiver.interrupt((evt, evt.value))
+
+    event.callbacks.append(signaller)
+    return event
