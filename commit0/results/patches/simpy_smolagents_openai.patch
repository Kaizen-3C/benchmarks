@@ -0,0 +1,28 @@
+from __future__ import annotations
+
+from time import monotonic, sleep
+
+from simpy.core import Environment
+
+class RealtimeEnvironment(Environment):
+    def __init__(self, initial_time=0, factor=1.0, strict=True):
+        super().__init__(initial_time)
+        self.factor = factor
+        self.strict = strict
+        self._rt_start = monotonic()
+        self._sim_start = initial_time
+
+    def sync(self):
+        self._rt_start = monotonic()
+        self._sim_start = self.now
+
+    def step(self):
+        evt_time = self.peek()
+        if evt_time != float('inf'):
+            target = self._rt_start + (evt_time - self._sim_start) * self.factor
+            delay = target - monotonic()
+            if delay > 0:
+                sleep(delay)
+            elif self.strict and -delay > self.factor:
+                raise RuntimeError('Simulation too slow for real time')
+        return super().step()
