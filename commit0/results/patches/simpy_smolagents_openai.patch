@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+from bisect import insort_right
+from collections import namedtuple
+
+from simpy.events import Event, Preempted
+from simpy.resources.base import BaseResource, Get, Put
+
+class Release(Get):
+    def __init__(self, resource, request):
+        self.request = request
+        super().__init__(resource)
+
+class Request(Put):
+    def __init__(self, resource):
+        self.usage_since = None
+        super().__init__(resource)
+
+class PriorityRequest(Request):
+    def __init__(self, resource, priority=0, preempt=True):
+        self.priority = priority
+        self.preempt = preempt
+        self.key = (priority, resource._env.now, not preempt)
+        super().__init__(resource)
+
+    def __lt__(self, other):
+        return self.key < other.key
+
+class SortedQueue(list):
+    maxlen = None
+    def append(self, item):
+        if self.maxlen is not None and len(self) >= self.maxlen:
+            raise RuntimeError('Cannot append event. Queue is full.')
+        insort_right(self, item)
+
+class Resource(BaseResource[Request, Release]):
+    def __init__(self, env, capacity=1):
+        if capacity <= 0:
+            raise ValueError('"capacity" must be > 0.')
+        super().__init__(env, capacity)
+        self.users = []
+
+    @property
+    def count(self):
+        return len(self.users)
+
+    @property
+    def queue(self):
+        return self.put_queue
+
+    def request(self):
+        return Request(self)
+
+    def release(self, request):
+        return Release(self, request)
+
+    put = request
+    get = release
+
+    def _do_put(self, event):
+        if len(self.users) < self.capacity:
+            self.users.append(event)
+            event.usage_since = self._env.now
+            event.succeed()
+            return True
+        return False
+
+    def _do_get(self, event):
+        try:
+            self.users.remove(event.request)
+        except ValueError:
+            if event.request in self.put_queue:
+                self.put_queue.remove(event.request)
+        event.succeed()
+        return True
+
+class PriorityResource(Resource):
+    PutQueue = SortedQueue
+
+    def request(self, priority=0):
+        return PriorityRequest(self, priority=priority, preempt=False)
+
+class PreemptiveResource(PriorityResource):
+    def request(self, priority=0, preempt=True):
+        req = PriorityRequest(self, priority=priority, preempt=preempt)
+        return req
+
+    def _do_put(self, event):
+        if len(self.users) >= self.capacity and event.preempt:
+            preempt_candidate = sorted(self.users, key=lambda e: e.key)[-1]
+            if preempt_candidate.key > event.key:
+                self.users.remove(preempt_candidate)
+                preempt_candidate.proc.interrupt(Preempted(by=event.proc, usage_since=preempt_candidate.usage_since, resource=self))
+        return super()._do_put(event)
