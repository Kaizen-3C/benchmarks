 """
 from marshmallow.exceptions import SCHEMA
 
+
 class ErrorStore:
 
     def __init__(self):
         self.errors = {}
 
+    def store_error(self, messages, field_name=SCHEMA, index=None):
+        """Store errors from a field or schema.
+        
+        :param messages: List of error messages.
+        :param field_name: Field name to store the error on.
+        :param index: Index of the item being validated, if validating a collection.
+        """
+        if index is not None:
+            if field_name not in self.errors:
+                self.errors[field_name] = {}
+            if index not in self.errors[field_name]:
+                self.errors[field_name][index] = []
+            self.errors[field_name][index] = merge_errors(
+                self.errors[field_name].get(index, []),
+                messages
+            )
+        else:
+            if field_name not in self.errors:
+                self.errors[field_name] = []
+            self.errors[field_name] = merge_errors(self.errors[field_name], messages)
+
+    def get_errors(self, index=None):
+        """Get the errors dictionary."""
+        return self.errors
+
+
 def merge_errors(errors1, errors2):
     """Deeply merge two error messages.
 
     The format of ``errors1`` and ``errors2`` matches the ``message``
     parameter of :exc:`marshmallow.exceptions.ValidationError`.
     """
-    pass
\ No newline at end of file
+    if not errors1:
+        return errors2
+    if not errors2:
+        return errors1
+    if isinstance(errors1, list) and isinstance(errors2, list):
+        return errors1 + errors2
+    if isinstance(errors1, dict) and isinstance(errors2, dict):
+        result = dict(errors1)
+        for key, val in errors2.items():
+            if key in result:
+                result[key] = merge_errors(result[key], val)
+            else:
+                result[key] = val
+        return result
+    if isinstance(errors1, list):
+        return errors1 + [errors2]
+    if isinstance(errors2, list):
+        return [errors1] + errors2
+    return [errors1, errors2]
