+def assert_imap_protocol(condition, message=None):
+    if not condition:
+        if isinstance(message, bytes):
+            message = message.decode("ascii", "replace")
+        raise exceptions.ProtocolError(message or "Server replied with a response that violates the IMAP protocol")
+
+def to_bytes(value, charset="ascii"):
+    if isinstance(value, bytes):
+        return value
+    if isinstance(value, str):
+        return value.encode(charset)
+    return str(value).encode("ascii")
+
+def to_unicode(value, charset="utf-8"):
+    if value is None:
+        return None
+    if isinstance(value, str):
+        return value
+    if isinstance(value, bytes):
+        return value.decode(charset, "replace")
+    return str(value)
+
+def chunk(it, size):
+    buf = []
+    for item in it:
+        buf.append(item)
+        if len(buf) == size:
+            yield tuple(buf)
+            buf = []
+    if buf:
+        yield tuple(buf)
