+    @property
+    def charset_name(self):
+        if self._name_prober:
+            return self._name_prober.charset_name
+        return self._model.charset_name
+
+    @property
+    def language(self):
+        return self._model.language
+
+    def reset(self):
+        super().reset()
+        self._last_order = CharacterCategory.UNDEFINED
+        self._seq_counters = [0] * SequenceLikelihood.get_num_categories()
+        self._total_seqs = 0
+        self._total_char = 0
+        self._control_char = 0
+        self._freq_char = 0
+
+    def feed(self, byte_str):
+        if not self._model.keep_ascii_letters:
+            byte_str = self.filter_international_words(byte_str)
+        for c in byte_str:
+            order = self._model.char_to_order_map[c]
+            if order < CharacterCategory.CONTROL:
+                self._total_char += 1
+            elif order == CharacterCategory.CONTROL:
+                self._control_char += 1
+
+            if order < self.SAMPLE_SIZE:
+                self._freq_char += 1
+                if self._last_order < self.SAMPLE_SIZE:
+                    self._total_seqs += 1
+                    if not self._reversed:
+                        lm_cat = self._model.language_model[self._last_order][order]
+                    else:
+                        lm_cat = self._model.language_model[order][self._last_order]
+                    self._seq_counters[lm_cat] += 1
+            self._last_order = order
+
+        if self._state == ProbingState.DETECTING:
+            confidence = self.get_confidence()
+            if confidence > self.POSITIVE_SHORTCUT_THRESHOLD:
+                self._state = ProbingState.FOUND_IT
+            elif confidence < self.NEGATIVE_SHORTCUT_THRESHOLD:
+                self._state = ProbingState.NOT_ME
+        return self._state
+
+    def get_confidence(self):
+        if self._total_seqs <= 0:
+            return 0.01
+        positive = self._seq_counters[SequenceLikelihood.POSITIVE]
+        likely = self._seq_counters[SequenceLikelihood.LIKELY]
+        r = (
+            (positive + 0.25 * likely)
+            / self._total_seqs
+            / self._model.typical_positive_ratio
+        )
+        r *= self._freq_char / max(self._total_char, 1)
+        r *= (self._total_char - self._control_char) / max(self._total_char, 1)
+        if r >= 1.0:
+            r = 0.99
+        return r
