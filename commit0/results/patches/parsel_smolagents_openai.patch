+from typing import List, Pattern, Union
+from lxml import etree
+
+
+def shorten(text: str, width: int) -> str:
+    if width < 0:
+        raise ValueError("width must be >= 0")
+    if len(text) <= width:
+        return text
+    if width <= 3:
+        return "." * width
+    return text[: width - 3] + "..."
+
+
+def _replace_html_entities(text: str) -> str:
+    if not text:
+        return text
+    text = text.replace("&quot;", '"')
+    text = text.replace("&apos;", "'")
+    text = text.replace("&lt;", "<")
+    text = text.replace("&gt;", ">")
+    return text
+
+
+def extract_regex(
+    regex: Union[str, Pattern[str]], text: str, replace_entities: bool = True
+) -> List[str]:
+    if isinstance(regex, str):
+        regex = re.compile(regex)
+
+    out: List[str] = []
+    for match in regex.finditer(text):
+        if regex.groupindex:
+            if "extract" in regex.groupindex:
+                values = [match.group("extract")]
+            else:
+                values = [match.group(name) for name in regex.groupindex.keys()]
+        elif match.groups():
+            values = list(match.groups())
+        else:
+            values = [match.group(0)]
+        out.extend(values)
+
+    if replace_entities:
+        out = [_replace_html_entities(x) for x in out]
+    return out
+
+
+def create_root_node(text: str, parser_cls: type, base_url: str = None, huge_tree: bool = True):
+    parser = parser_cls(recover=True, resolve_entities=False, huge_tree=huge_tree)
+    return etree.fromstring(text.encode("utf-8"), parser=parser, base_url=base_url)
