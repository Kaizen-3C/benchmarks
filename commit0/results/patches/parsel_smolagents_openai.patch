+_REGISTRY: Dict[str, Callable[..., Any]] = {}
+
+
+def has_class(context: Any, *classes: Any) -> bool:
+    if not classes:
+        raise ValueError("has-class must have at least 1 argument")
+    for c in classes:
+        if not isinstance(c, str):
+            raise ValueError("has-class arguments must be strings")
+        try:
+            c.encode("utf-8")
+        except Exception:
+            raise ValueError("All strings must be XML compatible")
+    node = context.context_node
+    cls = node.get("class") or node.get("CLASS") or ""
+    tokens = cls.replace("\n", " ").replace("\t", " ").split()
+    return all(c in tokens for c in classes)
+
+
+def set_xpathfunc(fname: str, func: Optional[Callable[..., Any]]) -> None:
+    ns = etree.FunctionNamespace(None)
+    if func is None:
+        if fname in _REGISTRY:
+            del _REGISTRY[fname]
+        ns.pop(fname, None)
+    else:
+        _REGISTRY[fname] = func
+        ns[fname] = func
+
+
+set_xpathfunc("has-class", has_class)
