+class _TranslatorMixin:
+    attribute_re = re.compile(r"^[A-Za-z_][A-Za-z0-9_:\-]*$")
+
+    def xpath_pseudo_element(self, xpath: XPathExpr, pseudo_element: object) -> XPathExpr:
+        if isinstance(pseudo_element, FunctionalPseudoElement):
+            name = pseudo_element.name
+            if name == "attr":
+                args = pseudo_element.arguments
+                if len(args) != 1:
+                    raise ExpressionError("::attr() requires 1 argument")
+                arg = getattr(args[0], "value", None)
+                if not isinstance(arg, str) or not self.attribute_re.match(arg):
+                    raise ExpressionError("Invalid attribute name")
+                return XPathExpr.from_xpath(xpath.path + "/@" + arg)
+            raise ExpressionError(f"Pseudo-element ::{name} is unknown")
+        if pseudo_element == "text":
+            return XPathExpr.from_xpath(xpath.path + "/text()")
+        if pseudo_element is not None:
+            raise ExpressionError(f"Pseudo-element ::{pseudo_element} is unknown")
+        return xpath
+
