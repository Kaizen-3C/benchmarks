+        # Reject public keys
+        invalid_strings = [
+            b"-----BEGIN PUBLIC KEY-----",
+            b"-----BEGIN CERTIFICATE-----",
+            b"-----BEGIN RSA PUBLIC KEY-----",
+            b"ssh-rsa",
+            b"ecdsa-sha2-nistp256",
+            b"ecdsa-sha2-nistp384",
