+def _make_wrapper(func, cache, reported_maxsize, typed, lock):
+    """Create a memoizing wrapper with cache_info and cache_parameters."""
+    _key = keys.typedkey if typed else keys.hashkey
+    hits = 0
+    misses = 0
+
+    if cache is None:
+        def wrapper(*args, **kwargs):
+            nonlocal misses
+            misses += 1
+            return func(*args, **kwargs)
+
+        def cache_clear():
+            nonlocal hits, misses
+            hits = misses = 0
+
+        def cache_info():
+            return _CacheInfo(hits, misses, 0, 0)
+
+    else:
+        def wrapper(*args, **kwargs):
+            nonlocal hits, misses
+            k = _key(*args, **kwargs)
+            try:
+                with lock:
+                    result = cache[k]
+                    hits += 1
+                    return result
+            except KeyError:
+                with lock:
+                    misses += 1
+            v = func(*args, **kwargs)
+            try:
+                with lock:
+                    return cache.setdefault(k, v)
+            except ValueError:
+                return v  # value too large
+
+        def cache_clear():
+            nonlocal hits, misses
+            with lock:
+                cache.clear()
+                hits = misses = 0
+
+        def cache_info():
+            with lock:
+                return _CacheInfo(hits, misses, reported_maxsize, cache.currsize)
+
+    import functools
+    wrapper = functools.update_wrapper(wrapper, func)
+    wrapper.cache = cache
+    wrapper.cache_key = _key
+    wrapper.cache_lock = lock
+    wrapper.cache_clear = cache_clear
+    wrapper.cache_info = cache_info
+    wrapper.cache_parameters = lambda: {"maxsize": reported_maxsize, "typed": typed}
+    return wrapper
+
