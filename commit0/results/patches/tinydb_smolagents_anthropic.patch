+try:
+    from mypy.nodes import NameExpr
+    from mypy.options import Options
+    from mypy.plugin import Plugin, DynamicClassDefContext
+    
+    T = TypeVar('T')
+    CB = Optional[Callable[[T], None]]
+    DynamicClassDef = DynamicClassDefContext
+
+    class TinyDBPlugin(Plugin):
+
+        def __init__(self, options: Options):
+            super().__init__(options)
+            self.named_placeholders: Dict[str, str] = {}
+
+        def get_dynamic_class_hook(self, fullname: str) -> Optional[CB]:
+            if fullname == 'tinydb.utils.with_typehint':
+                return self._with_typehint_hook
+            return None
+
+        def _with_typehint_hook(self, ctx: DynamicClassDefContext) -> None:
+            # Replace the dynamic class with the base class
+            if ctx.call.args:
+                arg = ctx.call.args[0]
+                if isinstance(arg, NameExpr):
+                    ctx.api.add_symbol_table_node(
+                        ctx.name,
+                        ctx.api.lookup_fully_qualified_or_none(arg.fullname or arg.name)
+                    )
+
+    def plugin(version: str):
+        return TinyDBPlugin
+
+except ImportError:
+    # mypy is not installed, provide a no-op plugin factory
+    def plugin(version: str):
+        return None
